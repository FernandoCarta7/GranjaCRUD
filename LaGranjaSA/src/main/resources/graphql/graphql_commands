
# ================== QUERIES ==================

# Clientes
query {
  getClientes {
    cedula
    nombres
    apellidos
    direccion
    telefono
  }
}

query {
  getClienteById(cedula: "1034987623") {
    cedula
    nombres
    apellidos
    direccion
    telefono
  }
}

# Razas
query {
  getRazas {
    idRaza
    descripcion
  }
}

query {
  getRazaById(idRaza: "1") {
    idRaza
    descripcion
  }
}

query {
  getRazaByDescripcion(descripcion: "York") {
    idRaza
    descripcion
  }
}

# Porcinos
query {
  getPorcinos {
    id_porcino
    fecha_nacimiento
    peso
    edad
    cliente {
      cedula
      nombres
    }
    raza {
      idRaza
      descripcion
    }
  }
}

query {
  getPorcinoById(id_porcino: "2") {
    id_porcino
    fecha_nacimiento
    peso
    edad
    cliente {
      cedula
      nombres
    }
    raza {
      descripcion
    }
  }
}

# Alimentación
query {
  getAlimentacion {
    id_alimentacion
    etapa
    descripcion
    dosis
    raza {
      idRaza
      descripcion
    }
  }
}

query {
  getAlimentacionById(id_alimentacion: "5") {
    id_alimentacion
    etapa
    descripcion
    dosis
    raza {
      descripcion
    }
  }
}

# ================== MUTATIONS ==================

# Cliente
mutation {
  saveCliente(cliente: {
    cedula: "123"
    nombres: "Juan"
    apellidos: "Pérez"
    direccion: "Calle 10"
    telefono: "3001234567"
  }) {
    cedula
    nombres
    apellidos
  }
}

mutation ($cliente: ClienteInput!) {
  saveCliente(cliente: $cliente) {
    cedula
    nombres
    apellidos
    direccion
    telefono
  }
}
}

mutation {
  updateCliente(
    cedula: "123456789"
    cliente: {
      telefono: "3109876543"
    }
  ) {
    cedula
    nombres
    apellidos
    direccion
    telefono
  }
}

mutation {
  deleteCliente(cedula: "123")
}

# Raza
mutation {
  saveRaza(raza: {
    descripcion: "Yorkshire"
  }) {
    idRaza
    descripcion
  }
}

mutation {
  updateRaza(
    idRaza: "1"
    raza: {
      descripcion: "Yorkshire-mejorada"
    }
  ) {
    idRaza
    descripcion
  }
}

mutation {
  deleteRaza(idRaza: "4")
}

